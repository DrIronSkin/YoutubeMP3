<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YoutubeMP3.ViewModels"
        x:Class="YoutubeMP3.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="YouTube MP3 Downloader"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="#1E1E2E">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="30">
        
        <TextBlock Grid.Row="0" 
                   Text="YouTube MP3 Downloader" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="#F5E0DC" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>
        
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <TextBox Grid.Column="0"
                     Text="{Binding Url, Mode=TwoWay}"
                     PlaceholderText="Paste the YouTube URL..."
                     VerticalContentAlignment="Center"
                     CornerRadius="8"
                     Padding="14,12"
                     FontSize="14"
                     Margin="0,0,12,0"/>

            <Button Grid.Column="1"
                    Content="Search"
                    Command="{Binding GetVideoInformationCommand}"
                    CornerRadius="8"
                    Padding="24,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#89B4FA"
                    Foreground="#11111B"/>
        </Grid>
        
        <Border Grid.Row="2"
                Background="#313244"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20"
                VerticalAlignment="Stretch"
                IsVisible="{Binding CurrentVideo, Converter={x:Static ObjectConverters.IsNotNull}}">
            
            <Grid RowDefinitions="2*, *">
                    <StackPanel Grid.Row="0" Spacing="12">
                        <TextBlock Text="{Binding CurrentVideo?.Title}" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="#CDD6F4" 
                                   TextWrapping="Wrap"/>
                                   
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding CurrentVideo?.Author, StringFormat='👤 {0}'}" 
                                       FontSize="24" 
                                       Foreground="#A6ADC8"/>
                                       
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentVideo?.Duration, StringFormat='⏱ {0}'}" 
                                       FontSize="24" 
                                       Foreground="#A6ADC8"/>
                        </Grid>
                    </StackPanel>
                
                <Button Grid.Row="1"
                        Content="Download MP3" 
                        Command="{Binding DownloadCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,15,0,0"
                        CornerRadius="8"
                        Padding="12"
                        FontSize="15"
                        Background="#A6E3A1"
                        Foreground="#11111B"
                        FontWeight="Bold"/>
            </Grid>
        </Border>
        
        <StackPanel Grid.Row="3" Spacing="8" VerticalAlignment="Bottom">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}" 
                           FontSize="24" 
                           Foreground="LightGreen"/>
                
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressValue, StringFormat='{}{0:0}%'}" 
                           FontSize="13" 
                           FontWeight="Bold"
                           Foreground="#89B4FA"
                           IsVisible="{Binding IsDownloading}"/>
            </Grid>
            
            <ProgressBar Value="{Binding ProgressValue}" 
                         Minimum="0" 
                         Maximum="100" 
                         Height="10" 
                         CornerRadius="5"
                         Foreground="#89B4FA"
                         Background="#45475A"
                         IsVisible="{Binding IsDownloading}"/>
        </StackPanel>
    </Grid>
</Window>