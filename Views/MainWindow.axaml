<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YoutubeMP3.ViewModels"
        xmlns:views="using:YoutubeMP3.Views"
        x:Class="YoutubeMP3.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="YouTube MP3 Downloader"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Background="#1E1E2E">

    <Grid RowDefinitions="Auto, Auto, Auto, *, 128" Margin="30">
        
        <TextBlock Grid.Row="0" 
                   Text="YouTube MP3 Downloader" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="#F5E0DC" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>
        
        <Grid Grid.Row="1" ColumnDefinitions="150,*, Auto" Margin="0,0,0,20">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Choices}"
                      SelectedIndex="0"
                      VerticalContentAlignment="Center"
                      HorizontalAlignment="Stretch"
                      CornerRadius="8"
                      Padding="14,12"
                      Margin="0,0,12,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Url, Mode=TwoWay}"
                     PlaceholderText="Paste the YouTube URL..."
                     VerticalContentAlignment="Center"
                     CornerRadius="8"
                     Padding="14,12"
                     FontSize="14"
                     Margin="0,0,12,0"/>

            <Button Grid.Column="2"
                    Content="Search"
                    Command="{Binding GetVideoInformationCommand}"
                    CornerRadius="8"
                    Padding="24,12"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="#89B4FA"
                    Foreground="#11111B"/>
        </Grid>
        
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#A6ADC8"
                   FontSize="24"
                   FontStyle="Italic"
                   HorizontalAlignment="Stretch"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>
        
        <views:VideoPreviewView Grid.Row="3"/>
        
        <views:ProgressView Grid.Row="4"/>
    </Grid>
</Window>